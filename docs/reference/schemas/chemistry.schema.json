{
  "$defs": {
    "AssetMechanism": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "chemkin",
            "cantera_yaml",
            "fluent_table"
          ],
          "title": "Format",
          "type": "string"
        },
        "mechanism_asset": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "title": "Mechanism Asset",
          "type": "string"
        },
        "thermodynamics_asset": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thermodynamics Asset"
        },
        "transport_asset": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Asset"
        },
        "type": {
          "const": "asset",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "format",
        "mechanism_asset"
      ],
      "title": "AssetMechanism",
      "type": "object"
    },
    "BuiltinMechanism": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "builtin",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "BuiltinMechanism",
      "type": "object"
    },
    "Composition": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "mass_fraction",
            "mole_fraction"
          ],
          "title": "Basis",
          "type": "string"
        },
        "fractions": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$": {
              "type": "number"
            }
          },
          "propertyNames": {
            "maxLength": 96,
            "minLength": 1
          },
          "title": "Fractions",
          "type": "object"
        }
      },
      "required": [
        "basis",
        "fractions"
      ],
      "title": "Composition",
      "type": "object"
    },
    "DiffusionFgmSetupProbe": {
      "additionalProperties": false,
      "description": "Fully declared exploratory setup for discovering Fluent 2026 R1 defaults.\n\nThe scope is deliberately limited to model setup and readback.  ``calc_fla`` and\n``calc_pdf`` are prohibited until every runtime-derived value is reviewed and\nreplaced by a frozen, hash-audited table-generation definition.",
      "properties": {
        "classification": {
          "const": "engineer_selected_exploratory",
          "title": "Classification",
          "type": "string"
        },
        "compressibility": {
          "const": true,
          "default": true,
          "title": "Compressibility",
          "type": "boolean"
        },
        "equilibrium_operating_pressure": {
          "$ref": "#/$defs/Quantity"
        },
        "execution_scope": {
          "const": "setup_readback_only",
          "title": "Execution Scope",
          "type": "string"
        },
        "fluent_release": {
          "const": "2026R1",
          "title": "Fluent Release",
          "type": "string"
        },
        "fuel_stream": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "title": "Fuel Stream",
          "type": "string"
        },
        "mixture_name": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "title": "Mixture Name",
          "type": "string"
        },
        "oxidizer_stream": {
          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
          "title": "Oxidizer Stream",
          "type": "string"
        },
        "probability_density_function": {
          "const": "beta",
          "title": "Probability Density Function",
          "type": "string"
        },
        "progress_variable_definition": {
          "const": "fluent_default",
          "title": "Progress Variable Definition",
          "type": "string"
        },
        "progress_variable_variance": {
          "const": "transport",
          "title": "Progress Variable Variance",
          "type": "string"
        },
        "runtime_defaults": {
          "$ref": "#/$defs/FluentDefaultsProbe"
        },
        "table_generation_permission": {
          "const": "prohibited",
          "title": "Table Generation Permission",
          "type": "string"
        },
        "turbulence_chemistry_interaction": {
          "const": "finite_rate",
          "title": "Turbulence Chemistry Interaction",
          "type": "string"
        },
        "type": {
          "const": "fluent_diffusion_fgm_setup_probe",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "classification",
        "execution_scope",
        "table_generation_permission",
        "fluent_release",
        "mixture_name",
        "fuel_stream",
        "oxidizer_stream",
        "equilibrium_operating_pressure",
        "progress_variable_definition",
        "turbulence_chemistry_interaction",
        "progress_variable_variance",
        "probability_density_function",
        "runtime_defaults"
      ],
      "title": "DiffusionFgmSetupProbe",
      "type": "object"
    },
    "EdcControls": {
      "additionalProperties": false,
      "properties": {
        "aggressiveness_factor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Aggressiveness Factor",
          "type": "number"
        },
        "flow_iterations_per_chemistry_update": {
          "minimum": 1,
          "title": "Flow Iterations Per Chemistry Update",
          "type": "integer"
        }
      },
      "required": [
        "aggressiveness_factor",
        "flow_iterations_per_chemistry_update"
      ],
      "title": "EdcControls",
      "type": "object"
    },
    "FiniteRateChemistry": {
      "additionalProperties": false,
      "properties": {
        "edc_controls": {
          "anyOf": [
            {
              "$ref": "#/$defs/EdcControls"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "discriminator": {
            "mapping": {
              "asset": "#/$defs/AssetMechanism",
              "builtin": "#/$defs/BuiltinMechanism"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BuiltinMechanism"
            },
            {
              "$ref": "#/$defs/AssetMechanism"
            }
          ],
          "title": "Mechanism"
        },
        "stiff_chemistry_solver": {
          "default": true,
          "title": "Stiff Chemistry Solver",
          "type": "boolean"
        },
        "stiff_solver_controls": {
          "anyOf": [
            {
              "$ref": "#/$defs/StiffSolverControls"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "turbulence_interaction": {
          "default": "none",
          "enum": [
            "none",
            "eddy_dissipation",
            "finite_rate_eddy_dissipation",
            "edc"
          ],
          "title": "Turbulence Interaction",
          "type": "string"
        },
        "type": {
          "const": "finite_rate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mechanism"
      ],
      "title": "FiniteRateChemistry",
      "type": "object"
    },
    "FlameletChemistry": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffusionFgmSetupProbe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "discriminator": {
            "mapping": {
              "asset": "#/$defs/AssetMechanism",
              "builtin": "#/$defs/BuiltinMechanism"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BuiltinMechanism"
            },
            {
              "$ref": "#/$defs/AssetMechanism"
            }
          ],
          "title": "Mechanism"
        },
        "nonadiabatic": {
          "default": true,
          "title": "Nonadiabatic",
          "type": "boolean"
        },
        "partially_premixed": {
          "default": false,
          "title": "Partially Premixed",
          "type": "boolean"
        },
        "progress_variable": {
          "default": true,
          "title": "Progress Variable",
          "type": "boolean"
        },
        "table_asset": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Asset"
        },
        "table_mode": {
          "default": "read",
          "enum": [
            "read",
            "calculate"
          ],
          "title": "Table Mode",
          "type": "string"
        },
        "type": {
          "const": "flamelet",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "mechanism"
      ],
      "title": "FlameletChemistry",
      "type": "object"
    },
    "FluentDefaultsProbe": {
      "additionalProperties": false,
      "description": "Runtime defaults that must be captured and frozen before table generation.\n\nThis is intentionally a setup-only contract.  It makes release-specific Fluent\ndefaults visible without pretending that a paper specified them or allowing a\ntable calculation to proceed with implicit choices.",
      "properties": {
        "fluent_release": {
          "const": "2026R1",
          "title": "Fluent Release",
          "type": "string"
        },
        "freeze_before_table_generation": {
          "const": true,
          "default": true,
          "title": "Freeze Before Table Generation",
          "type": "boolean"
        },
        "groups": {
          "items": {
            "enum": [
              "chemistry",
              "boundary",
              "progress_variable_definition",
              "control",
              "flamelet",
              "table",
              "premix",
              "combustion_parameters",
              "material_density"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        },
        "record_allowed_values": {
          "const": true,
          "default": true,
          "title": "Record Allowed Values",
          "type": "boolean"
        },
        "require_complete_group_state": {
          "const": true,
          "default": true,
          "title": "Require Complete Group State",
          "type": "boolean"
        }
      },
      "required": [
        "fluent_release",
        "groups"
      ],
      "title": "FluentDefaultsProbe",
      "type": "object"
    },
    "NoChemistry": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "NoChemistry",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A finite scalar whose unit is always explicit.\n\nUnit conversion deliberately belongs to the compiler.  The schema keeps\nthe authored value and unit intact so plans and evidence remain auditable.",
      "properties": {
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "StiffSolverControls": {
      "additionalProperties": false,
      "properties": {
        "absolute_ode_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Absolute Ode Tolerance",
          "type": "number"
        },
        "relative_ode_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Relative Ode Tolerance",
          "type": "number"
        }
      },
      "required": [
        "absolute_ode_tolerance",
        "relative_ode_tolerance"
      ],
      "title": "StiffSolverControls",
      "type": "object"
    },
    "StreamSpec": {
      "additionalProperties": false,
      "properties": {
        "composition": {
          "$ref": "#/$defs/Composition"
        },
        "temperature": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "temperature",
        "composition"
      ],
      "title": "StreamSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "model": {
      "discriminator": {
        "mapping": {
          "finite_rate": "#/$defs/FiniteRateChemistry",
          "flamelet": "#/$defs/FlameletChemistry",
          "none": "#/$defs/NoChemistry"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoChemistry"
        },
        {
          "$ref": "#/$defs/FiniteRateChemistry"
        },
        {
          "$ref": "#/$defs/FlameletChemistry"
        }
      ],
      "title": "Model"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "streams": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$": {
          "$ref": "#/$defs/StreamSpec"
        }
      },
      "propertyNames": {
        "maxLength": 96,
        "minLength": 1
      },
      "title": "Streams",
      "type": "object"
    },
    "tracked_species": {
      "items": {
        "maxLength": 96,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Tracked Species",
      "type": "array"
    }
  },
  "required": [
    "model"
  ],
  "title": "ChemistryDocument",
  "type": "object"
}
