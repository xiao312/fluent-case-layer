{
  "$defs": {
    "EquationNumerics": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "spatial_scheme": {
          "anyOf": [
            {
              "enum": [
                "first_order_upwind",
                "second_order_upwind",
                "power_law",
                "quick",
                "bounded_central_differencing",
                "central_differencing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spatial Scheme"
        },
        "under_relaxation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Under Relaxation"
        }
      },
      "title": "EquationNumerics",
      "type": "object"
    },
    "NumericsProfile": {
      "additionalProperties": false,
      "properties": {
        "equations": {
          "patternProperties": {
            "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$": {
              "$ref": "#/$defs/EquationNumerics"
            }
          },
          "propertyNames": {
            "maxLength": 96,
            "minLength": 1
          },
          "title": "Equations",
          "type": "object"
        },
        "expert_controls": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Expert Controls",
          "type": "object"
        },
        "extends": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extends"
        },
        "gradient": {
          "anyOf": [
            {
              "enum": [
                "green_gauss_cell_based",
                "green_gauss_node_based",
                "least_squares_cell_based"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gradient"
        },
        "pressure": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "presto",
                "linear",
                "second_order",
                "body_force_weighted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure"
        },
        "pressure_velocity_coupling": {
          "anyOf": [
            {
              "enum": [
                "simple",
                "simplec",
                "piso",
                "coupled"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Velocity Coupling"
        },
        "transient": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransientNumerics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "NumericsProfile",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A finite scalar whose unit is always explicit.\n\nUnit conversion deliberately belongs to the compiler.  The schema keeps\nthe authored value and unit intact so plans and evidence remain auditable.",
      "properties": {
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "TransientNumerics": {
      "additionalProperties": false,
      "properties": {
        "formulation": {
          "enum": [
            "first_order_implicit",
            "second_order_implicit",
            "bounded_second_order_implicit"
          ],
          "title": "Formulation",
          "type": "string"
        },
        "max_courant": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Courant"
        },
        "max_iterations_per_step": {
          "default": 20,
          "minimum": 1,
          "title": "Max Iterations Per Step",
          "type": "integer"
        },
        "time_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "formulation"
      ],
      "title": "TransientNumerics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "default_profile": {
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "title": "Default Profile",
      "type": "string"
    },
    "profiles": {
      "patternProperties": {
        "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$": {
          "$ref": "#/$defs/NumericsProfile"
        }
      },
      "propertyNames": {
        "maxLength": 96,
        "minLength": 1
      },
      "title": "Profiles",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "default_profile",
    "profiles"
  ],
  "title": "NumericsDocument",
  "type": "object"
}
